{
  "name": "multiclaw",
  "version": "0.4.0",
  "type": "module",
  "bin": {
    "multiclaw": "dist/index.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shipengqi/multiclaw.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/shipengqi/multiclaw#readme",
  "bugs": {
    "url": "https://github.com/shipengqi/multiclaw/issues"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist --composite false --incremental false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.90.0",
    "@agentclientprotocol/codex-acp": "^2.2.2",
    "@inquirer/prompts": "^8.7.3",
    "@multiclawcli/core": "workspace:*",
    "@multiclawcli/dashboard": "workspace:*",
    "commander": "^15.0.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
