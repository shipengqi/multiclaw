{
  "name": "@multiclawcli/dashboard",
  "version": "0.5.0",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./dist/tui/index.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shipengqi/multiclaw.git",
    "directory": "packages/dashboard"
  },
  "homepage": "https://github.com/shipengqi/multiclaw#readme",
  "bugs": {
    "url": "https://github.com/shipengqi/multiclaw/issues"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@multiclawcli/core": "workspace:*",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
