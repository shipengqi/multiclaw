{
  "name": "multiclaw-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm lint && pnpm -r build && pnpm -r typecheck && pnpm test",
    "prepare": "husky",
    "dev:example": "pnpm --filter dev-team-example run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsup": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.0.0",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.12.0 || >=24.0.0",
      "onFail": "download"
    }
  }
}
